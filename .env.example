# Copia este archivo a .env para personalizar la conexión.
WPP_SESSION=chatbot
WPP_HEADLESS=true
# Tiempo para escanear el QR, en milisegundos. 0 desactiva el límite.
WPP_AUTO_CLOSE=120000
# Opcional: ruta absoluta a Chrome/Chromium si no se detecta automáticamente.
WPP_BROWSER_PATH=

# Servicios migrados. Los valores locales se copian a .env, nunca a este archivo.
OPENAI_API_KEY=
OPENAI_TIMEOUT_MS=120000
EMAIL_TOKEN=
KEYWORD_CAPTURE_MESSAGE_ORDER=
ENABLE_MODEL_CLASSIFICATION=false
# Número fijo de segundos o rango, por ejemplo 45-60.
SILENCE_TEXT_AUDIO_SECONDS=5
WHATSAPP_API_BASE_URL=https://c0jkurvt19.execute-api.us-east-1.amazonaws.com/DEV
HTTP_TIMEOUT_MS=30000
# Opcional: usar otro binario de ffmpeg en lugar del incluido.
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# API de envío: por compatibilidad usa PORT + 10000 (3000 -> 13000).
PORT=3000
# API_PORT=13000
API_HOST=0.0.0.0

# CloudWatch. Se puede desactivar para trabajar localmente.
CLOUDWATCH_ENABLED=true
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIRECTORY=logs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
