# Variables de despliegue para las Lambdas de Instagram/Messenger.
# Estas integraciones son independientes del proceso de WhatsApp.
AWS_REGION=us-east-1
OPENAI_API_KEY=
TABLE_NAME=
TABLE_NAME_CHAT=
TABLE_NAME_SESSIONES=
TABLE_NAME_SETTING=
# BASE_URL y PROMPT_BASE_URL permiten cambiar el backend de créditos/prompts.
BASE_URL=
PROMPT_BASE_URL=
# Extensión web: opcional, ruta de ffmpeg en Lambda.
FFMPEG_PATH=
