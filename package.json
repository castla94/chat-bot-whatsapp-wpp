{
  "name": "chat-bot-whatsapp-wpp",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de WhatsApp con WPPConnect",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "check": "node scripts/check-syntax.cjs",
    "test": "node --test",
    "diagnose": "node --env-file-if-exists=.env scripts/diagnose.cjs",
    "audit:migration": "node scripts/audit-migration.cjs"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "@wppconnect-team/wppconnect": "^2.3.6",
    "@aws-sdk/client-cloudwatch-logs": "^3.0.0",
    "axios": "^1.7.3",
    "cache-manager": "5.2.4",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.2",
    "mime-types": "2.1.35",
    "openai": "^4.55.7",
    "sharp": "^0.33.4",
    "wa-sticker-formatter": "4.4.4",
    "winston": "^3.17.0",
    "winston-cloudwatch": "^6.3.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/util-dynamodb": "^3.0.0",
    "@aws-sdk/client-lambda": "^3.0.0"
  }
}
